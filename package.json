{
  "name": "stateless-engineering",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless engineering monorepo: packages, benchmarks, docs, and provenance for the org",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bench:all": "node packages/bench-runner/run.js packages/benchmarks",
    "bench:one": "node packages/bench-runner/run.js packages/benchmarks --only",
    "webshell": "node packages/webshell/webshell.js",
    "test": "node --test packages/*/test/*.test.js",
    "ticket": "node packages/ticket/bin/ticket.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
